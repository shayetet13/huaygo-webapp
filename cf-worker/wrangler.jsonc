{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huay77",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
