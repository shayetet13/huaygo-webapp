# ไม่ตั้ง = ใช้ SQLite local (data/huay.db) เหมือนเดิม | ตั้งค่า = ใช้ Postgres (Supabase) แทน
# แนะนำ Supabase connection pooler (transaction mode, port 6543) ไม่ใช่ direct connection (5432)
# ระวัง: ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / ? #) ต้อง URL-encode ก่อนใส่ในนี้
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
JWT_SECRET=changeme-generate-a-long-random-string
LICENSE_HMAC_SECRET=changeme-generate-a-different-long-random-string
# เข้ารหัส LINE channel secret/access token ต่อร้านใน shop_line_channels — สร้างด้วย
# `openssl rand -hex 32` (ต้องเป็น hex 64 ตัวอักษรพอดี) ห้ามเปลี่ยนทีหลังโดยไม่ decrypt ข้อมูลเดิมก่อน
SHOP_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
# LINE Login channel ID ของ LIFF app กลาง "lotto" (ใช้ทุกร้าน online ร่วมกัน) — ใช้เช็ค `aud`
# ตอน verify LIFF idToken (services/liffAuth.service.ts) หาได้จากหน้า LINE Developers Console
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
HUAY_USER=your-huay-provider-username
HUAY_PASS=your-huay-provider-password
FRONTEND_ORIGIN=http://localhost:5173
# LINE ของร้าน 1 (legacy) — ใช้ครั้งเดียวตอน migrate เข้า shop_line_channels เท่านั้น ลบออกได้หลัง migrate
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-api-channel-access-token
LINE_CHANNEL_SECRET=your-line-messaging-api-channel-secret
OCR_SERVICE_URL=http://localhost:8000
# รหัสผ่านบัญชีระบบตอน seed ครั้งแรก (DB ว่าง) — ตั้งเป็นค่าสุ่มแข็งแรง ห้ามใช้ค่าตัวอย่างนี้จริง
# บัญชี dev = ผู้คุมระบบทั้งหมด (platform owner), บัญชี member เริ่มต้น = MemTNTXOJ05
# หลัง seed แล้วเปลี่ยนรหัสผ่านผ่าน UI ได้ ค่านี้ใช้เฉพาะตอนสร้างบัญชีครั้งแรก
# ⚠️ ถ้ารหัสผ่านมีอักขระ # ต้องครอบด้วยเครื่องหมายคำพูดเสมอ (เช่น DEV_SEED_PASSWORD="abc#123")
#    ไม่งั้น dotenv จะตัดทุกอย่างหลัง # ทิ้งแบบเงียบๆ (ตีความเป็น comment) — รหัสผ่านจะสั้นกว่าที่ตั้งไว้จริง
DEV_SEED_PASSWORD=changeme-generate-a-strong-random-password
MEMBER_SEED_PASSWORD=changeme-generate-a-different-strong-random-password
# Public HTTPS base URL LINE can reach (the Cloudflare named tunnel domain) — used to build the
# PromptPay QR image URL embedded in LINE messages. Must NOT be localhost/LAN — LINE's servers fetch it.
PUBLIC_BASE_URL=https://huay-webhook.nexapos.io
